# Copy this file to ".env" and fill in your own values. Never commit ".env".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
DB_NAME=AstroSpell
PORT=3001

# Optional: only needed if you serve the front end from a different address
# (for example VS Code Live Server). Comma separated.
# CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
